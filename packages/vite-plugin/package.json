{
  "name": "@ripple-ts/vite-plugin",
  "description": "Vite plugin for Ripple",
  "license": "MIT",
  "author": "Dominic Gannaway",
  "version": "0.5.9",
  "type": "module",
  "module": "src/index.js",
  "main": "src/index.js",
  "bin": {
    "ripple-preview": "src/bin/preview.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./stylex": {
      "types": "./stylex/index.d.ts",
      "import": "./stylex/index.js",
      "default": "./stylex/index.js"
    },
    "./stylex/jsx": {
      "types": "./stylex/jsx.d.ts"
    },
    "./production": {
      "import": "./src/server/production.js",
      "default": "./src/server/production.js",
      "types": "./types/production.d.ts"
    }
  },
  "homepage": "https://ripple-ts.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ripple-TS/ripple.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/Ripple-TS/ripple/issues"
  },
  "dependencies": {
    "@ripple-ts/adapter": "workspace:*",
    "@tsrx/core": "catalog:default",
    "@tsrx/ripple": "workspace:*"
  },
  "devDependencies": {
    "@stylexjs/atoms": "catalog:default",
    "@stylexjs/stylex": "catalog:default",
    "@stylexjs/unplugin": "catalog:default",
    "@types/node": "catalog:default",
    "devalue": "catalog:default",
    "ripple": "workspace:*",
    "type-fest": "catalog:default",
    "vite": "catalog:default"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1"
  },
  "peerDependenciesMeta": {
    "@stylexjs/stylex": {
      "optional": true
    },
    "@stylexjs/unplugin": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
