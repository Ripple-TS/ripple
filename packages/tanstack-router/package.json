{
  "name": "@ripple-ts/tanstack-router",
  "version": "0.0.3",
  "description": "Native TanStack Router integration for Ripple",
  "type": "module",
  "license": "MIT",
  "author": "Ripple Team",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ripple-TS/ripple.git",
    "directory": "packages/tanstack-router"
  },
  "bugs": {
    "url": "https://github.com/Ripple-TS/ripple/issues"
  },
  "homepage": "https://ripple-ts.com",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./ssr/server": {
      "types": "./types/ssr/server.d.ts",
      "default": "./src/ssr/server.js"
    },
    "./ssr/client": {
      "types": "./types/ssr/client.d.ts",
      "default": "./src/ssr/client.js"
    }
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "test": "pnpm -w test --project tanstack-router-client --project tanstack-router-server --project tanstack-router-tooling",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.upstream.json && tsc --noEmit -p tests/fixtures/solid-reference/tsconfig.json && pnpm --filter @ripple-ts/router-ssr-example typecheck",
    "upstream:inventory": "node scripts/inventory-upstream.js",
    "upstream:audit": "node scripts/audit-upstream.js",
    "test:browser": "pnpm --filter @ripple-ts/router-ssr-example build && node tests/browser/run.js",
    "test:release": "node scripts/test-release.js"
  },
  "dependencies": {
    "@tanstack/history": "catalog:default",
    "@tanstack/router-core": "catalog:default"
  },
  "peerDependencies": {
    "ripple": "workspace:^"
  },
  "devDependencies": {
    "@ripple-ts/vite-plugin": "workspace:*",
    "@testing-library/dom": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "@tsrx/ripple": "workspace:*",
    "@types/node": "catalog:default",
    "combinate": "catalog:default",
    "jsdom": "catalog:default",
    "playwright": "catalog:default",
    "ripple": "workspace:*",
    "typescript": "catalog:default",
    "vite": "catalog:default",
    "vitest": "catalog:default",
    "zod": "catalog:default"
  },
  "publishConfig": {
    "access": "public"
  }
}
